#!/usr/bin/env bash
set -euo pipefail
export HOME=/root

path=/opt/overlab
ref="${1:-}"
sha="${2:-}"

if ! printf '%s' "$ref" | grep -Eq '^[A-Za-z0-9._][A-Za-z0-9._/-]*$'; then
  echo "The ref is not valid" >&2
  exit 2
fi
if [ -n "$sha" ] && ! printf '%s' "$sha" | grep -Eq '^[0-9a-f]{40}$'; then
  echo "The commit id is not valid" >&2
  exit 2
fi

cd "$path"
compose="docker compose -f docker-compose.prod.yml --env-file .env.prod"
db_user="$(grep -E '^DB_USER=' .env.prod | cut -d= -f2-)"
db_name="$(grep -E '^DB_NAME=' .env.prod | cut -d= -f2-)"
for attempt in $(seq 1 40); do
  running="$($compose exec -T postgres psql -U "${db_user:-overlab}" -d "${db_name:-overlab}" -At -c "select count(*) from collector_runs where status = 'RUNNING'" < /dev/null || echo 0)"
  if [ "$running" = "0" ]; then
    break
  fi
  echo "The collector is running, waiting ($attempt/40)"
  sleep 30
done
before="$(git rev-parse HEAD)"
git fetch --tags --prune origin
git checkout --force "$ref"
if [ -n "$sha" ]; then
  git reset --hard "$sha"
elif git show-ref --verify --quiet "refs/remotes/origin/$ref"; then
  git reset --hard "origin/$ref"
fi
$compose up -d --build
if git diff --name-only "$before" HEAD | grep -q '^docker/grafana/'; then
  $compose restart grafana
fi
docker image prune -f
echo "Deployed $(git rev-parse --short HEAD)"
