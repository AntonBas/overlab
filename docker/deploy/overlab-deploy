#!/usr/bin/env bash
set -euo pipefail
export HOME=/root

path=/opt/overlab
ref="${1:-}"
sha="${2:-}"

if ! printf '%s' "$ref" | grep -Eq '^[A-Za-z0-9._][A-Za-z0-9._/-]*$'; then
  echo "The ref is not valid" >&2
  exit 2
fi
if [ -n "$sha" ] && ! printf '%s' "$sha" | grep -Eq '^[0-9a-f]{40}$'; then
  echo "The commit id is not valid" >&2
  exit 2
fi

cd "$path"
compose="docker compose -f docker-compose.prod.yml --env-file .env.prod"
db_user="$(grep -E '^DB_USER=' .env.prod | cut -d= -f2-)"
db_name="$(grep -E '^DB_NAME=' .env.prod | cut -d= -f2-)"
for attempt in $(seq 1 40); do
  running="$($compose exec -T postgres psql -U "${db_user:-overlab}" -d "${db_name:-overlab}" -At -c "select count(*) from collector_runs where status = 'RUNNING'" < /dev/null || echo 0)"
  if [ "$running" = "0" ]; then
    break
  fi
  echo "The collector is running, waiting ($attempt/40)"
  sleep 30
done
before="$(git rev-parse HEAD)"
backup_path="$(grep -E '^BACKUP_PATH=' .env.prod | cut -d= -f2- || true)"
backup_path="${backup_path:-./backups}"
mkdir -p "$backup_path"
predeploy_dump="$backup_path/overlab-predeploy-$(date -u +%Y%m%dT%H%M%SZ)-${before:0:12}.sql.gz"
$compose exec -T postgres pg_dump -U "${db_user:-overlab}" -d "${db_name:-overlab}" < /dev/null | gzip > "$predeploy_dump.tmp"
if ! gzip -t "$predeploy_dump.tmp" || [ "$(gzip -dc "$predeploy_dump.tmp" | wc -c)" -lt 1024 ]; then
  rm -f "$predeploy_dump.tmp"
  echo "The pre-deploy database dump failed, nothing was deployed" >&2
  exit 1
fi
mv "$predeploy_dump.tmp" "$predeploy_dump"
echo "Pre-deploy dump written: $predeploy_dump"
git fetch --tags --prune origin
git checkout --force "$ref"
if [ -n "$sha" ]; then
  git reset --hard "$sha"
elif git show-ref --verify --quiet "refs/remotes/origin/$ref"; then
  git reset --hard "origin/$ref"
fi
target="$(git rev-parse HEAD)"

wait_for_version() {
  for attempt in $(seq 1 60); do
    if $compose exec -T backend wget -qO- http://localhost:9091/actuator/info < /dev/null 2>/dev/null | grep -q "$1" \
      && $compose exec -T backend wget -qO- http://localhost:9091/actuator/health/readiness < /dev/null 2>/dev/null | grep -q UP; then
      return 0
    fi
    sleep 5
  done
  return 1
}

export APP_VERSION="$target"
$compose up -d --build
if ! wait_for_version "$target"; then
  echo "The new version did not become ready, rolling back to $before" >&2
  git checkout --force "$before"
  export APP_VERSION="$before"
  $compose up -d --build
  if wait_for_version "$before"; then
    echo "Rolled back to ${before:0:12}. Database migrations are not reverted; restore $predeploy_dump if the schema changed." >&2
  else
    echo "The rollback did not become ready either, check the stack by hand" >&2
  fi
  exit 1
fi
if git diff --name-only "$before" HEAD | grep -q '^docker/grafana/'; then
  $compose restart grafana
fi
docker image prune -f
echo "Deployed $(git rev-parse --short HEAD)"
