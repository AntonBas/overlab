{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	@notSvgMedia not path /media/*.svg
	header @notSvgMedia Content-Security-Policy "default-src 'self'; script-src 'self' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; connect-src 'self' https://cloud.umami.is; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	@uploads path /api/admin/maps/*/image /api/admin/perks/*/icon
	handle @uploads {
		request_body {
			max_size 3MB
		}
		reverse_proxy backend:8080
	}

	@sitemap path /sitemap.xml
	handle @sitemap {
		rewrite * /api/sitemap.xml
		reverse_proxy backend:8080
	}

	@robots path /robots.txt
	handle @robots {
		header Content-Type text/plain
		respond <<ROBOTS
			User-agent: *
			Disallow: /admin
			Sitemap: {scheme}://{hostport}/sitemap.xml
			ROBOTS 200
	}

	@svgMedia path /media/*.svg
	handle @svgMedia {
		reverse_proxy backend:8080 {
			header_down Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
			header_down Cache-Control "public, max-age=86400"
			header_down -Pragma
			header_down -Expires
		}
	}

	@mapImages path /media/maps/*
	handle @mapImages {
		reverse_proxy backend:8080 {
			header_down Cache-Control "public, max-age=31536000, immutable"
			header_down -Pragma
			header_down -Expires
		}
	}

	@media path /media/*
	handle @media {
		reverse_proxy backend:8080 {
			header_down Cache-Control "public, max-age=86400"
			header_down -Pragma
			header_down -Expires
		}
	}

	@backend path /api/* /oauth2/* /login/oauth2/*
	handle @backend {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8080
	}

	@hashedAssets path /assets/*
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	@appShell not path /assets/*
	handle {
		header @appShell Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

{$WWW_ADDRESS:http://www.localhost} {
	redir {$CANONICAL_URL:http://localhost}{uri} permanent
}
