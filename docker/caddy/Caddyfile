{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-site
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	@notSvgMedia not path /media/*.svg
	header @notSvgMedia Content-Security-Policy "default-src 'self'; script-src 'self' https://cloud.umami.is; style-src 'self'; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; connect-src 'self' https://cloud.umami.is https://gateway.umami.is https://*.ingest.de.sentry.io; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	@uploads path /api/admin/maps/*/image /api/admin/perks/*/icon
	handle @uploads {
		request_body {
			max_size 3MB
		}
		reverse_proxy backend:8080
	}

	@sitemap path /sitemap.xml
	handle @sitemap {
		rewrite * /api/sitemap.xml
		reverse_proxy backend:8080
	}

	@robots path /robots.txt
	handle @robots {
		header Content-Type text/plain
		respond <<ROBOTS
			User-agent: *
			Disallow: /admin
			Disallow: /feedback
			Disallow: /api/
			Disallow: /me
			Disallow: /login
			Disallow: /register
			Disallow: /confirm-deletion
			Disallow: /oauth2/
			Sitemap: {scheme}://{hostport}/sitemap.xml
			ROBOTS 200
	}

	@svgMedia path /media/*.svg
	handle @svgMedia {
		reverse_proxy backend:8080 {
			header_down Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
			header_down Cache-Control "public, max-age=86400"
			header_down -Pragma
			header_down -Expires
		}
	}

	@mapImages path /media/maps/*
	handle @mapImages {
		reverse_proxy backend:8080 {
			@mapImageFound status 2xx
			handle_response @mapImageFound {
				copy_response_headers {
					exclude Cache-Control Pragma Expires
				}
				header >Cache-Control "public, max-age=31536000, immutable"
				copy_response
			}
		}
	}

	@media path /media/*
	handle @media {
		reverse_proxy backend:8080 {
			header_down Cache-Control "public, max-age=86400"
			header_down -Pragma
			header_down -Expires
		}
	}

	@backend path /api/* /oauth2/* /login/oauth2/*
	handle @backend {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8080
	}

	@staticHtmlBot {
		header_regexp userAgent User-Agent (?i)(googlebot|google-inspectiontool|facebookexternalhit|facebot|twitterbot|telegrambot|discordbot|slackbot|slack-imgproxy|whatsapp|linkedinbot|pinterestbot|skypeuripreview|vkshare|viber|redditbot|mastodon|bluesky|signal|bingbot|adidxbot|duckduckbot|yandexbot|baiduspider|applebot|slurp|seznambot)
		path_regexp ^/(|stats|heroes|counters|perks|changes|maps|guides|privacy|terms|cookies|business|heroes/[a-z0-9-]+|heroes/[a-z0-9-]+/(?:perks|counters|maps|guides)|maps/[a-z0-9-]+|maps/[a-z0-9-]+/guides|guides/[A-Za-z0-9-]+)/?$
	}
	handle @staticHtmlBot {
		header Cache-Control "public, max-age=300"
		rewrite * /api/seo/preview?path={http.request.uri.path}
		reverse_proxy backend:8080 {
			header_down Vary User-Agent
			header_down -Cache-Control
		}
	}

	@entityPage path_regexp entityPage ^/((?:heroes|maps|guides)/[^/]+(?:/(?:perks|counters|maps|guides))?)/?$
	@heroOnMapPage path_regexp heroOnMapPage ^/(maps/[^/]+)/[^/]+/?$

	handle @entityPage {
		rewrite * /api/seo/exists?path=/{http.regexp.entityPage.1}
		reverse_proxy backend:8080 {
			@pageFound status 2xx
			handle_response @pageFound {
				root * /srv
				rewrite * /index.html
				file_server
			}
			@pageMissing status 404
			handle_response @pageMissing {
				root * /srv
				rewrite * /index.html
				file_server {
					status 404
				}
			}
		}
	}

	handle @heroOnMapPage {
		rewrite * /api/seo/exists?path=/{http.regexp.heroOnMapPage.1}
		reverse_proxy backend:8080 {
			@mapFound status 2xx
			handle_response @mapFound {
				root * /srv
				rewrite * /index.html
				file_server
			}
			@mapMissing status 404
			handle_response @mapMissing {
				root * /srv
				rewrite * /index.html
				file_server {
					status 404
				}
			}
		}
	}

	@hashedAssets {
		path /assets/*
		file
	}
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	@missingAsset {
		path /assets/*
		not file
	}
	header @missingAsset Cache-Control "no-store"

	@appShell not path /assets/* /api/* /media/* /oauth2/* /login/oauth2/* /sitemap.xml /robots.txt
	header @appShell Cache-Control "no-cache"

	root * /srv

	@staticFile file
	handle @staticFile {
		file_server
	}

	@appRoute path_regexp ^/(|stats|heroes|heroes/[^/]+|heroes/[^/]+/(perks|counters|maps|guides)|counters|perks|changes|patches(/.*)?|maps|maps/[^/]+|maps/[^/]+/[^/]+|guides|guides/[^/]+|feedback|business|privacy|terms|cookies|me|me/settings|confirm-deletion|login|register|verify-email|forgot-password|reset-password|admin(/.*)?)/?$
	handle @appRoute {
		rewrite * /index.html
		file_server
	}

	handle {
		rewrite * /index.html
		file_server {
			status 404
		}
	}

	handle_errors {
		header Retry-After "30"
		header Cache-Control "no-store"

		@upstreamDown expression {http.error.status_code} in [502, 503, 504]

		@apiPath path /api/* /oauth2/* /login/oauth2/* /media/* /sitemap.xml
		handle @upstreamDown {
			handle @apiPath {
				header Content-Type "application/json"
				respond `{"status":503,"error":"Service Unavailable","message":"The service is temporarily unavailable"}` 503
			}

			@pageRoute path_regexp ^/(heroes|maps|guides)/
			handle @pageRoute {
				root * /srv
				rewrite * /index.html
				file_server {
					status 503
				}
			}

			handle {
				respond "The service is temporarily unavailable. Please try again in a moment." 503
			}
		}

		handle {
			respond "{http.error.status_text}" {http.error.status_code}
		}
	}
}

{$WWW_ADDRESS:http://www.localhost} {
	redir {$CANONICAL_URL:http://localhost}{uri} permanent
}
