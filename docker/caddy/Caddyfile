{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	@uploads path /api/admin/maps/*/image /api/admin/perks/*/icon
	handle @uploads {
		request_body {
			max_size 3MB
		}
		reverse_proxy backend:8080
	}

	@sitemap path /sitemap.xml
	handle @sitemap {
		rewrite * /api/sitemap.xml
		reverse_proxy backend:8080
	}

	@robots path /robots.txt
	handle @robots {
		header Content-Type text/plain
		respond <<ROBOTS
			User-agent: *
			Disallow: /admin
			Sitemap: {scheme}://{hostport}/sitemap.xml
			ROBOTS 200
	}

	@mapImages path /media/maps/*
	handle @mapImages {
		reverse_proxy backend:8080 {
			header_down Cache-Control "public, max-age=31536000, immutable"
			header_down -Pragma
			header_down -Expires
		}
	}

	@media path /media/*
	handle @media {
		reverse_proxy backend:8080 {
			header_down Cache-Control "public, max-age=86400"
			header_down -Pragma
			header_down -Expires
		}
	}

	@backend path /api/* /oauth2/* /login/oauth2/*
	handle @backend {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8080
	}

	@hashedAssets path /assets/*
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
