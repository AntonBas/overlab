{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	@notSvgMedia not path /media/*.svg
	header @notSvgMedia Content-Security-Policy "default-src 'self'; script-src 'self' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; connect-src 'self' https://cloud.umami.is https://gateway.umami.is https://*.ingest.de.sentry.io; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	@uploads path /api/admin/maps/*/image /api/admin/perks/*/icon
	handle @uploads {
		request_body {
			max_size 3MB
		}
		reverse_proxy backend:8080
	}

	@sitemap path /sitemap.xml
	handle @sitemap {
		rewrite * /api/sitemap.xml
		reverse_proxy backend:8080
	}

	@robots path /robots.txt
	handle @robots {
		header Content-Type text/plain
		respond <<ROBOTS
			User-agent: *
			Disallow: /admin
			Disallow: /feedback
			Sitemap: {scheme}://{hostport}/sitemap.xml
			ROBOTS 200
	}

	@svgMedia path /media/*.svg
	handle @svgMedia {
		reverse_proxy backend:8080 {
			header_down Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
			header_down Cache-Control "public, max-age=86400"
			header_down -Pragma
			header_down -Expires
		}
	}

	@mapImages path /media/maps/*
	handle @mapImages {
		reverse_proxy backend:8080 {
			header_down Cache-Control "public, max-age=31536000, immutable"
			header_down -Pragma
			header_down -Expires
		}
	}

	@media path /media/*
	handle @media {
		reverse_proxy backend:8080 {
			header_down Cache-Control "public, max-age=86400"
			header_down -Pragma
			header_down -Expires
		}
	}

	@backend path /api/* /oauth2/* /login/oauth2/*
	handle @backend {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8080
	}

	@heroSection path_regexp heroSection ^/heroes/([a-z0-9-]+)/(perks|counters|maps)/?$
	handle @heroSection {
		redir * "/heroes/{http.regexp.heroSection.1}#{http.regexp.heroSection.2}" 301
	}

	@staticHtmlBot {
		header_regexp userAgent User-Agent (?i)(facebookexternalhit|facebot|twitterbot|telegrambot|discordbot|slackbot|slack-imgproxy|whatsapp|linkedinbot|pinterestbot|skypeuripreview|vkshare|viber|redditbot|mastodon|bluesky|signal|bingbot|adidxbot|duckduckbot|yandexbot|baiduspider|applebot|slurp|seznambot)
		path_regexp ^/(|stats|heroes|counters|perks|changes|maps|privacy|terms|cookies|business|heroes/[a-z0-9-]+|maps/[a-z0-9-]+|guides/[0-9]+(-[A-Za-z0-9-]*)?)/?$
	}
	handle @staticHtmlBot {
		rewrite * /api/seo/preview?path={http.request.uri.path}
		reverse_proxy backend:8080 {
			header_down Vary User-Agent
		}
	}

	@hashedAssets {
		path /assets/*
		file
	}
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	@missingAsset {
		path /assets/*
		not file
	}
	header @missingAsset Cache-Control "no-store"

	@appShell not path /assets/* /api/* /media/* /oauth2/* /login/oauth2/* /sitemap.xml /robots.txt
	header @appShell Cache-Control "no-cache"

	root * /srv

	@staticFile file
	handle @staticFile {
		file_server
	}

	@appRoute path_regexp ^/(|stats|heroes|heroes/[^/]+|counters|perks|changes|patches(/.*)?|maps|maps/[^/]+|maps/[^/]+/[^/]+|guides/[^/]+|feedback|business|privacy|terms|cookies|me|me/settings|login|register|verify-email|forgot-password|reset-password|admin(/.*)?)/?$
	handle @appRoute {
		rewrite * /index.html
		file_server
	}

	handle {
		rewrite * /index.html
		file_server {
			status 404
		}
	}
}

{$WWW_ADDRESS:http://www.localhost} {
	redir {$CANONICAL_URL:http://localhost}{uri} permanent
}
